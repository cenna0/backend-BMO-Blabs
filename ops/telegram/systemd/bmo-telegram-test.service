[Unit]
Description=BMO Telegram direct-path receipt test
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/local/libexec/bmo-hermes-health-notify test
LoadCredential=telegram-bot-token:/opt/bmo/config/telegram/bot-token
LoadCredential=telegram-chat-id:/opt/bmo/config/telegram/chat-id
UMask=0077
CapabilityBoundingSet=
LockPersonality=yes
LimitCORE=0
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
