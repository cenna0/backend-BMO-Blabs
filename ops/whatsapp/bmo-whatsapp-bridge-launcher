#!/bin/sh
set -eu

HERMES_HOME=/home/hermes/.hermes
ENV_FILE="$HERMES_HOME/.env"
NODE_BIN="$HERMES_HOME/node/bin/node"
SESSION_DIR="$HERMES_HOME/whatsapp/session"

read_env_value() {
  key="$1"
  awk -v key="$key" '
    /^[[:space:]]*#/ { next }
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      prefix = key "="
      if (index(line, prefix) != 1) next
      value = substr(line, length(prefix) + 1)
      sub(/\r$/, "", value)
      if (length(value) >= 2 && substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") value = substr(value, 2, length(value) - 2)
      if (length(value) >= 2 && substr(value, 1, 1) == "'" && substr(value, length(value), 1) == "'") value = substr(value, 2, length(value) - 2)
      print value
      exit
    }
  ' "$ENV_FILE"
}

[ -r "$ENV_FILE" ] || exit 78
[ -x "$NODE_BIN" ] || exit 78
[ -d "$SESSION_DIR" ] || exit 78

enabled="$(read_env_value WHATSAPP_ENABLED || true)"
mode="$(read_env_value WHATSAPP_MODE || true)"
allowed="$(read_env_value WHATSAPP_ALLOWED_USERS || true)"
[ "$enabled" = "false" ] || exit 78
[ "$mode" = "bot" ] || exit 78
case "$allowed" in
  *[[:space:]]*|*\**|*,,*|,*|*,) exit 78 ;;
esac

install_bridge="$HERMES_HOME/hermes-agent/scripts/whatsapp-bridge/bridge.js"
mirror_bridge="$HERMES_HOME/scripts/whatsapp-bridge/bridge.js"
bridge_script=""
for candidate in "$install_bridge" "$mirror_bridge"; do
  [ -f "$candidate" ] || continue
  candidate_dir=$(dirname "$candidate")
  [ -f "$candidate_dir/package.json" ] || continue
  [ -d "$candidate_dir/node_modules" ] || continue
  bridge_script="$candidate"
  break
done
[ -n "$bridge_script" ] || exit 78

export HOME="$HERMES_HOME"
export HERMES_HOME
export WHATSAPP_MODE=bot
if [ -n "$allowed" ]; then
  # This is an official bridge owner-forward gate only. It is not the BMO
  # notification policy; pairing DM policy still admits contact events.
  export WHATSAPP_ALLOWED_USERS="$allowed"
fi
# Official bridge bot behavior is used as transport only. Pairing policy
# admits contact events to the private queue; the Hermes gateway adapter stays
# disabled, and Backend rules own all notification/action authorization.
export WHATSAPP_DM_POLICY=pairing
export WHATSAPP_FORWARD_OWNER_MESSAGES=true
export WHATSAPP_GROUP_POLICY=disabled
export WHATSAPP_SEND_READ_RECEIPTS=false

exec "$NODE_BIN" "$bridge_script" --port 3001 --session "$SESSION_DIR" --mode bot
