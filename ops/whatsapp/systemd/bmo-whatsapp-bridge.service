[Unit]
Description=BMO WhatsApp connection-scoped Hermes Baileys bridge manager
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/.hermes
ExecStart=/home/hermes/.hermes/node/bin/node /usr/local/libexec/bmo-whatsapp-bridge-manager --port 3001 --sessions-root /home/hermes/.hermes/whatsapp/sessions --port-base 3101
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=PATH=/home/hermes/.hermes/node/bin:/usr/bin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# Manager and child bridge output can include provider identities. Health is read
# from loopback and no bridge output is retained.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
