[Unit]
Description=BMO Hermes WhatsApp provider identity resolver
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/.hermes
ExecStart=/home/hermes/.hermes/node/bin/node /usr/local/libexec/bmo-whatsapp-identity-resolver --port 3002 --session /home/hermes/.hermes/whatsapp/session --token-file=%d/resolver-token
LoadCredential=resolver-token:/opt/bmo/config/whatsapp/identity-resolver.token
Restart=on-failure
RestartSec=10s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=PATH=/home/hermes/.hermes/node/bin:/usr/bin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# The resolver reads only validated lid-mapping files in code. It never opens
# Baileys creds, keys, history, or media, and it emits no identity-bearing logs.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
