# Sanitized production Backend application environment template.
# Copy outside Git to /opt/bmo/config/p9.1/backend.env and replace only the
# placeholders through the protected operator secret-delivery process.

NODE_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
TRUST_PROXY_HOPS=1
PUBLIC_BASE_URL=https://api.personalbmo.web.id

DEVICE_ID=bmo-001
DEVICE_TOKEN=<operator-provisioned-device-token>

HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=<operator-provisioned-hermes-api-key>
HERMES_MODEL=hermes-agent
HERMES_CONVERSATION=bmo-001
HERMES_SOFT_TIMEOUT_MS=30000
HERMES_HARD_TIMEOUT_MS=180000
READINESS_PROBE_TIMEOUT_MS=2000

AUDIO_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_SERVICE_TOKEN=<operator-provisioned-internal-service-token>
AUDIO_SERVICE_STT_TIMEOUT_MS=90000
AUDIO_SERVICE_TTS_TIMEOUT_MS=180000

TEMP_AUDIO_DIR=/opt/bmo/temp/audio
TEMP_AUDIO_TTL_SECONDS=300
TEMP_AUDIO_CLEANUP_INTERVAL_SECONDS=30
REQUEST_TOMBSTONE_TTL_SECONDS=600
MAX_REQUEST_STORE_ENTRIES=1000
MAX_AUDIO_BYTES=3145728
MAX_AUDIO_DURATION_SECONDS=60
TOTAL_PIPELINE_TIMEOUT_MS=300000

HARDWARE_TEST_MODE=false
WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_INTERVAL_MS=60000
WS_MAX_MISSED_PONGS=2
WS_MAX_MESSAGE_BYTES=8192

# P9 application values. The frozen Backend has no *_FILE contract for these
# two values, so they remain in this protected env file and are never placed
# in Git, Compose YAML, logs, or command-line arguments.
P9_ENABLED=true
P9_JWT_SECRET=<operator-provisioned-32-byte-or-longer-secret>
P9_PAIRING_PEPPER=<operator-provisioned-32-byte-or-longer-secret>

# Compose supplies the database password and file-backed secrets at runtime:
# P9_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
# P9_WIFI_ENCRYPTION_KEY_FILE=/run/secrets/wifi_encryption_key
# WHATSAPP_IDENTITY_RESOLVER_TOKEN_FILE=/run/secrets/whatsapp_identity_resolver_token
# SPOTIFY_CLIENT_ID_FILE=/run/secrets/spotify_client_id
# SPOTIFY_CLIENT_SECRET_FILE=/run/secrets/spotify_client_secret
# SPOTIFY_TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/spotify_token_encryption_key

WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_IDENTITY_RESOLVER_URL=http://127.0.0.1:3002
SPOTIFY_CALLBACK_URL=https://api.personalbmo.web.id/api/v1/integrations/spotify/callback
AVATAR_STORAGE_DIR=/opt/bmo/data/avatars
BUG_REPORT_STORAGE_DIR=/opt/bmo/data/bug-reports
AVATAR_UPLOAD_RECEIVE_TIMEOUT_MS=30000
