generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvitationStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PairingStatus {
  ISSUED
  CLAIMED
  EXPIRED
  REVOKED
  INVALIDATED
  FAILED
}

enum ResponseLength {
  BRIEF
  STANDARD
  DETAILED
}

enum NotificationBehavior {
  ALL
  IMPORTANT
  NONE
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageKind {
  TEXT
  EVENT
}

enum ChatOperationStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ChatFeedbackRating {
  POSITIVE
  NEGATIVE
}

enum MemoryCandidateStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MemoryActionType {
  ACCEPT
  REJECT
  EDIT
  DELETE
  FORGET_TOPIC
  CLEAR_ALL
  EXPORT
  SUMMARY_REGENERATE
  SUMMARY_FEEDBACK
}

enum MemorySummaryStatus {
  READY
  GENERATING
  FAILED
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum ScheduleRunStatus {
  DUE
  CLAIMED
  SUCCEEDED
  FAILED
  MISSED
  CANCELLED
}

enum DeliverySource {
  CHAT
  SCHEDULE
  WHATSAPP
}

enum ProactiveDeliveryStatus {
  PENDING
  READY
  DELIVERING
  DELIVERED
  FAILED
  EXPIRED
  MISSED
}

enum DeliveryAttemptStatus {
  PENDING
  SENT
  RECEIVED
  PLAYED
  FAILED
  EXPIRED
}

enum WifiSecurity {
  OPEN
  WPA_PSK
}

enum WifiConfigurationStatus {
  PENDING
  DELIVERED
  APPLYING
  CONNECTED
  FAILED
  ROLLED_BACK
  SUPERSEDED
}

enum DeviceLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum IntegrationProvider {
  SPOTIFY
  WHATSAPP
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
  RECONNECT_REQUIRED
}

enum SpotifyActionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum WhatsAppRuleScope {
  ALL
  CONTACT
  GROUP
}

enum WhatsAppConversationType {
  DM
  GROUP
}

enum WhatsAppSendStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  SENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum WhatsAppDeliveryDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppDeliveryStatus {
  RECEIVED
  QUEUED
  DELIVERED
  FAILED
}

enum BugReportStatus {
  RECEIVED
  TRIAGED
  RESOLVED
  CLOSED
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  email                     String                     @unique @db.VarChar(320)
  displayName               String?                    @db.VarChar(120)
  dateOfBirth               DateTime?                  @db.Date
  username                  String?                    @unique @db.VarChar(30)
  avatarKey                 String?                    @unique @db.VarChar(255)
  avatarContentType         String?                    @db.VarChar(100)
  avatarByteSize            Int?
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  identities                AuthIdentity[]
  passwordCredential        PasswordCredential?
  invitations               Invitation[]
  sessions                  Session[]
  devices                   Device[]
  pairings                  DevicePairing[]
  userSettings              UserSettings?
  auditEvents               AuditEvent[]
  passwordRecoveries        PasswordRecovery[]
  personalizationSettings   PersonalizationSettings?
  chatSessions              ChatSession[]
  chatMessages              ChatMessage[]
  chatOperations            ChatOperation[]
  chatMessageFeedback       ChatMessageFeedback[]
  memoryRecords             MemoryRecord[]
  memoryCandidates          MemoryCandidate[]
  memoryActions             MemoryAction[]
  memoryTopicForgets        MemoryTopicForget[]
  memorySummary             MemorySummary?
  schedules                 Schedule[]
  proactiveDeliveries       ProactiveDelivery[]
  deliveryAttempts          DeliveryAttempt[]
  integrationConnections    IntegrationConnection[]
  oauthStates               OAuthState[]
  spotifyCredential         SpotifyCredential?
  spotifyActions            SpotifyAction[]
  whatsAppConversations     WhatsAppConversation[]
  whatsAppConversationAliases WhatsAppConversationAlias[]
  whatsAppNotificationRules WhatsAppNotificationRule[]
  whatsAppSendRequests      WhatsAppSendRequest[]
  whatsAppDeliveries        WhatsAppDelivery[]
  bugReports                BugReport[]
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String   @db.VarChar(255)
  algorithm    String   @default("argon2id") @db.VarChar(32)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @db.VarChar(320)
  tokenHash  String           @unique @db.Char(64)
  status     InvitationStatus @default(ACTIVE)
  expiresAt  DateTime         @db.Timestamptz(3)
  acceptedAt DateTime?        @db.Timestamptz(3)
  revokedAt  DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  createdBy  String?          @db.Uuid
  user       User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([email, status, expiresAt])
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  clientDeviceId String?        @db.Uuid
  familyId       String         @db.Uuid
  expiresAt      DateTime       @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  revokedReason  String?        @db.VarChar(64)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  lastUsedAt     DateTime?      @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientDevice   Device?        @relation("SessionClientDevice", fields: [clientDeviceId, userId], references: [id, userId], onDelete: Restrict, map: "Session_client_device_owner_fkey")
  refreshTokens  RefreshToken[]

  @@unique([familyId])
  @@unique([id, familyId])
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, clientDeviceId])
  @@index([familyId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  familyId  String    @db.Uuid
  issuedAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId, familyId], references: [id, familyId], onDelete: Cascade, map: "RefreshToken_session_family_fkey")

  @@index([sessionId, familyId, expiresAt])
  @@index([familyId, usedAt, revokedAt])
}

model Device {
  id                  String                    @id @default(uuid()) @db.Uuid
  userId              String                    @db.Uuid
  hardwareId          String                    @unique @db.VarChar(128)
  name                String                    @db.VarChar(120)
  tokenHash           String                    @db.Char(64)
  status              DeviceStatus              @default(PENDING)
  pairedAt            DateTime?                 @db.Timestamptz(3)
  revokedAt           DateTime?                 @db.Timestamptz(3)
  lastSeenAt          DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientSessions      Session[]                 @relation("SessionClientDevice")
  pairings            DevicePairing[]
  settings            DeviceSettings?
  auditEvents         AuditEvent[]
  chatSessions        ChatSession[]             @relation("ChatSessionDevice")
  sourceChatMessages  ChatMessage[]             @relation("ChatMessageSourceDevice")
  targetSchedules     Schedule[]                @relation("ScheduleTargetDevice")
  proactiveDeliveries ProactiveDelivery[]       @relation("ProactiveDeliveryDevice")
  deliveryAttempts    DeliveryAttempt[]         @relation("DeliveryAttemptDevice")
  wifiConfigurations  DeviceWifiConfiguration[]
  telemetryCurrent    DeviceTelemetryCurrent?
  logs                DeviceLog[]

  @@unique([id, userId])
  @@index([userId, status])
}

model DevicePairing {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  deviceId      String?       @db.Uuid
  codeHash      String        @db.Char(64)
  status        PairingStatus @default(ISSUED)
  expiresAt     DateTime      @db.Timestamptz(3)
  attemptCount  Int           @default(0)
  maxAttempts   Int           @default(5)
  lastAttemptAt DateTime?     @db.Timestamptz(3)
  claimedAt     DateTime?     @db.Timestamptz(3)
  revokedAt     DateTime?     @db.Timestamptz(3)
  invalidatedAt DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?       @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Restrict, map: "DevicePairing_device_owner_fkey")

  @@index([userId, status, expiresAt])
  @@index([codeHash, status])
}

model UserSettings {
  id                        String         @id @default(uuid()) @db.Uuid
  userId                    String         @unique @db.Uuid
  language                  String         @default("en") @db.VarChar(16)
  responseLength            ResponseLength @default(STANDARD)
  automaticMemoryCandidates Boolean        @default(true)
  timezone                  String         @default("Asia/Jakarta") @db.VarChar(64)
  createdAt                 DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime       @updatedAt @db.Timestamptz(3)
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceSettings {
  id                   String               @id @default(uuid()) @db.Uuid
  deviceId             String               @unique @db.Uuid
  displayName          String?              @db.VarChar(120)
  defaultDevice        Boolean              @default(false)
  playbackVolume       Int                  @default(80)
  quietHours           Json?
  notificationBehavior NotificationBehavior @default(ALL)
  voiceProfileId       String               @default("prudence") @db.VarChar(32)
  speechSpeed          Float                @default(1.0)
  enabled              Boolean              @default(true)
  version              Int                  @default(1)
  deliveredAt          DateTime?            @db.Timestamptz(3)
  appliedVersion       Int?
  appliedAt            DateTime?            @db.Timestamptz(3)
  lastErrorCode        String?              @db.VarChar(64)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  device               Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  deviceId     String?  @db.Uuid
  actorType    String   @db.VarChar(32)
  eventType    String   @db.VarChar(64)
  outcome      String   @db.VarChar(32)
  resourceType String   @db.VarChar(64)
  resourceId   String?  @db.VarChar(128)
  requestId    String?  @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device       Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
}

model PasswordRecovery {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tokenVerifier        String    @unique @db.Char(64)
  expiresAt            DateTime  @db.Timestamptz(3)
  usedAt               DateTime? @db.Timestamptz(3)
  attemptCount         Int       @default(0)
  maxAttempts          Int
  lastAttemptAt        DateTime? @db.Timestamptz(3)
  requestIpHash        String?   @db.Char(64)
  requestUserAgentHash String?   @db.Char(64)
  requestId            String?   @db.VarChar(128)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model PersonalizationSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  baseStyleTone      String   @default("default") @db.VarChar(32)
  warmth             String   @default("default") @db.VarChar(32)
  enthusiasm         String   @default("default") @db.VarChar(32)
  headerAndLists     String   @default("default") @db.VarChar(32)
  emoji              String   @default("default") @db.VarChar(32)
  fastAnswers        Boolean  @default(false)
  customInstructions String   @default("") @db.VarChar(4000)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  deviceId          String?           @db.Uuid
  temporary         Boolean           @default(false)
  title             String?           @db.VarChar(200)
  status            ChatSessionStatus @default(ACTIVE)
  lastMessageCursor BigInt?
  lastMessageAt     DateTime?         @db.Timestamptz(3)
  expiresAt         DateTime?         @db.Timestamptz(3)
  deletedAt         DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device            Device?           @relation("ChatSessionDevice", fields: [deviceId, userId], references: [id, userId], onDelete: Restrict, map: "ChatSession_device_owner_fkey")
  messages          ChatMessage[]

  @@unique([id, userId])
  @@index([userId, status, updatedAt])
  @@index([userId, deviceId])
}

model ChatMessage {
  id               String                @id @default(uuid()) @db.Uuid
  sessionId        String                @db.Uuid
  userId           String                @db.Uuid
  sourceDeviceId   String?               @db.Uuid
  role             ChatMessageRole
  kind             ChatMessageKind       @default(TEXT)
  content          String                @db.Text
  metadata         Json?
  cursor           BigInt                @default(autoincrement())
  idempotencyKey   String?               @db.VarChar(128)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  deletedAt        DateTime?             @db.Timestamptz(3)
  session          ChatSession           @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice     Device?               @relation("ChatMessageSourceDevice", fields: [sourceDeviceId, userId], references: [id, userId], onDelete: Restrict, map: "ChatMessage_source_device_owner_fkey")
  operations       ChatOperation[]
  feedback         ChatMessageFeedback[]
  memoryCandidates MemoryCandidate[]

  @@unique([id, userId])
  @@unique([sessionId, cursor])
  @@unique([userId, idempotencyKey])
  @@index([userId, sessionId, cursor])
  @@index([userId, sourceDeviceId])
}

model ChatOperation {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  userMessageId  String              @db.Uuid
  idempotencyKey String              @db.VarChar(128)
  status         ChatOperationStatus @default(PROCESSING)
  errorCode      String?             @db.VarChar(64)
  startedAt      DateTime            @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?           @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessage    ChatMessage         @relation(fields: [userMessageId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userMessageId])
  @@unique([userId, idempotencyKey])
  @@index([userId, status, startedAt])
}

model ChatMessageFeedback {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  messageId String             @db.Uuid
  rating    ChatFeedbackRating
  reason    String?            @db.VarChar(500)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   ChatMessage        @relation(fields: [messageId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, messageId])
}

model MemoryRecord {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  topic             String    @db.VarChar(120)
  category          String    @db.VarChar(64)
  normalizedContent String    @db.Text
  importance        Int
  source            String    @db.VarChar(64)
  expiresAt         DateTime? @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, updatedAt])
  @@index([userId, topic])
  @@index([expiresAt])
}

model MemoryCandidate {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  sourceMessageId String?               @db.Uuid
  proposedContent String                @db.Text
  topic           String?               @db.VarChar(120)
  policyMetadata  Json?
  status          MemoryCandidateStatus @default(PENDING)
  expiresAt       DateTime?             @db.Timestamptz(3)
  reviewedAt      DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage   ChatMessage?          @relation(fields: [sourceMessageId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

model MemoryAction {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  actionType     MemoryActionType
  resourceType   String           @db.VarChar(32)
  resourceId     String?          @db.Uuid
  idempotencyKey String           @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, resourceType, resourceId, createdAt])
}

model MemoryTopicForget {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  normalizedTopic String   @db.VarChar(120)
  idempotencyKey  String   @db.VarChar(128)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, normalizedTopic, createdAt])
}

model MemorySummary {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @db.Uuid
  content     String?             @db.Text
  status      MemorySummaryStatus @default(GENERATING)
  version     Int                 @default(1)
  feedback    String?             @db.VarChar(500)
  generatedAt DateTime?           @db.Timestamptz(3)
  expiresAt   DateTime?           @db.Timestamptz(3)
  deletedAt   DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  targetDeviceId String?        @db.Uuid
  status         ScheduleStatus @default(ACTIVE)
  timezone       String         @default("Asia/Jakarta") @db.VarChar(64)
  recurrence     Json?
  payload        Json
  nextRunAt      DateTime?      @db.Timestamptz(3)
  version        Int            @default(1)
  cancelledAt    DateTime?      @db.Timestamptz(3)
  completedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDevice   Device?        @relation("ScheduleTargetDevice", fields: [targetDeviceId, userId], references: [id, userId], onDelete: Restrict, map: "Schedule_target_device_owner_fkey")
  runs           ScheduleRun[]

  @@unique([id, userId])
  @@index([status, nextRunAt])
  @@index([userId, status, updatedAt])
  @@index([userId, targetDeviceId])
}

model ScheduleRun {
  id             String            @id @default(uuid()) @db.Uuid
  scheduleId     String            @db.Uuid
  dueAt          DateTime          @db.Timestamptz(3)
  status         ScheduleRunStatus @default(DUE)
  leaseOwner     String?           @db.VarChar(128)
  leaseExpiresAt DateTime?         @db.Timestamptz(3)
  attemptCount   Int               @default(0)
  retryAt        DateTime?         @db.Timestamptz(3)
  missedAt       DateTime?         @db.Timestamptz(3)
  result         Json?
  errorCode      String?           @db.VarChar(64)
  startedAt      DateTime?         @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  schedule       Schedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dueAt])
  @@index([status, dueAt, leaseExpiresAt])
  @@index([retryAt])
}

model ProactiveDelivery {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @db.Uuid
  deviceId           String?                 @db.Uuid
  source             DeliverySource
  sourceResourceType String                  @db.VarChar(32)
  sourceResourceId   String                  @db.Uuid
  idempotencyKey     String                  @db.VarChar(128)
  status             ProactiveDeliveryStatus @default(PENDING)
  audioKey           String?                 @db.VarChar(255)
  audioExpiresAt     DateTime?               @db.Timestamptz(3)
  attemptCount       Int                     @default(0)
  errorCode          String?                 @db.VarChar(64)
  expiresAt          DateTime?               @db.Timestamptz(3)
  deliveredAt        DateTime?               @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device             Device?                 @relation("ProactiveDeliveryDevice", fields: [deviceId, userId], references: [id, userId], onDelete: Restrict, map: "ProactiveDelivery_device_owner_fkey")
  attempts           DeliveryAttempt[]

  @@unique([userId, idempotencyKey])
  @@unique([id, userId])
  @@index([status, createdAt])
  @@index([userId, source, sourceResourceId])
  @@index([userId, deviceId])
  @@index([expiresAt])
}

model DeliveryAttempt {
  id            String                @id @default(uuid()) @db.Uuid
  deliveryId    String                @db.Uuid
  userId        String                @db.Uuid
  deviceId      String?               @db.Uuid
  attemptNumber Int
  status        DeliveryAttemptStatus @default(PENDING)
  channel       String                @db.VarChar(32)
  receiptId     String?               @db.VarChar(128)
  errorCode     String?               @db.VarChar(64)
  errorDetail   String?               @db.VarChar(500)
  sentAt        DateTime?             @db.Timestamptz(3)
  receivedAt    DateTime?             @db.Timestamptz(3)
  playedAt      DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  delivery      ProactiveDelivery     @relation(fields: [deliveryId, userId], references: [id, userId], onDelete: Cascade, map: "DeliveryAttempt_delivery_owner_fkey")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?               @relation("DeliveryAttemptDevice", fields: [deviceId, userId], references: [id, userId], onDelete: Restrict, map: "DeliveryAttempt_device_owner_fkey")

  @@unique([deliveryId, attemptNumber])
  @@index([userId, status, createdAt])
  @@index([userId, deviceId])
}

model DeviceWifiConfiguration {
  id               String                  @id @default(uuid()) @db.Uuid
  deviceId         String                  @db.Uuid
  version          Int
  ssid             String                  @db.VarChar(32)
  security         WifiSecurity
  secretCiphertext String?                 @db.Text
  secretNonce      String?                 @db.VarChar(128)
  secretTag        String?                 @db.VarChar(128)
  secretKeyVersion Int?
  status           WifiConfigurationStatus @default(PENDING)
  deliveredAt      DateTime?               @db.Timestamptz(3)
  applyingAt       DateTime?               @db.Timestamptz(3)
  connectedAt      DateTime?               @db.Timestamptz(3)
  failedAt         DateTime?               @db.Timestamptz(3)
  rolledBackAt     DateTime?               @db.Timestamptz(3)
  supersededAt     DateTime?               @db.Timestamptz(3)
  errorCode        String?                 @db.VarChar(64)
  errorDetail      String?                 @db.VarChar(500)
