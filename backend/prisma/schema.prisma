  sendRequest        WhatsAppSendRequest?      @relation(fields: [sendRequestId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([connectionId, providerMessageRef])
  @@index([expiresAt])
}

model BugReport {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  category    String                @db.VarChar(64)
  description String                @db.VarChar(4000)
  context     String?               @db.VarChar(4000)
  status      BugReportStatus       @default(RECEIVED)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  resolvedAt  DateTime?             @db.Timestamptz(3)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments BugReportAttachment[]

  @@index([userId, status, createdAt])
}

model BugReportAttachment {
  id          String    @id @default(uuid()) @db.Uuid
  bugReportId String    @db.Uuid
  storageKey  String    @unique @db.VarChar(255)
  contentType String    @db.VarChar(100)
  byteSize    Int
  sha256      String    @db.Char(64)
  expiresAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  @@index([bugReportId, createdAt])
  @@index([expiresAt])
}
