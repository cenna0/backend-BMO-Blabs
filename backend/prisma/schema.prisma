model WhatsAppDelivery {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @db.Uuid
  connectionId       String                    @db.Uuid
  provider           IntegrationProvider       @default(WHATSAPP)
  conversationId     String?                   @db.Uuid
  sendRequestId      String?                   @db.Uuid
  direction          WhatsAppDeliveryDirection
  status             WhatsAppDeliveryStatus
  providerMessageRef String?                   @db.VarChar(255)
  metadata           String?                   @db.VarChar(2000)
  errorCode          String?                   @db.VarChar(64)
  deliveredAt        DateTime?                 @db.Timestamptz(3)
  expiresAt          DateTime?                 @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
