  conversation           WhatsAppConversation? @relation(fields: [conversationId, userId, provider], references: [id, userId, provider], onDelete: Restrict, map: "WhatsAppSendRequest_conversation_owner_provider_fkey")
  deliveries            WhatsAppDelivery[]

  @@unique([id, userId])
