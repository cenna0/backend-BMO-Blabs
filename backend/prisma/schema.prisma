model DeviceTelemetryCurrent {
  id               String   @id @default(uuid()) @db.Uuid
  deviceId         String   @unique @db.Uuid
  wifiConnected    Boolean  @default(false)
  wifiRssi         Int?
  batterySupported Boolean  @default(false)
  batteryPercent   Int?
  firmwareVersion  String?  @db.VarChar(64)
  observedAt       DateTime @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceLog {
  id         String         @id @default(uuid()) @db.Uuid
  deviceId   String         @db.Uuid
  level      DeviceLogLevel
  code       String         @db.VarChar(64)
  message    String         @db.VarChar(1000)
  metadata   String?        @db.VarChar(2000)
  observedAt DateTime       @db.Timestamptz(3)
  expiresAt  DateTime       @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  device     Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, observedAt])
  @@index([expiresAt])
}

model IntegrationConnection {
  id                   String                     @id @default(uuid()) @db.Uuid
  userId               String                     @db.Uuid
  provider             IntegrationProvider
  status               IntegrationStatus          @default(DISCONNECTED)
  externalReference    String?                    @db.VarChar(255)
  scopes               String[]
  statusMetadata       String?                    @db.VarChar(2000)
  connectedAt          DateTime?                  @db.Timestamptz(3)
  disconnectedAt       DateTime?                  @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyCredential    SpotifyCredential?
  spotifyActions       SpotifyAction[]
  whatsAppRules        WhatsAppNotificationRule[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppConversationAliases WhatsAppConversationAlias[]
  whatsAppSendRequests WhatsAppSendRequest[]
  whatsAppDeliveries   WhatsAppDelivery[]

  @@unique([userId, provider])
  @@unique([id, userId, provider])
  @@index([status, updatedAt])
}

model OAuthState {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  provider      IntegrationProvider
  stateVerifier String              @unique @db.Char(64)
  redirectUri   String              @db.VarChar(2048)
  requestId     String?             @db.VarChar(128)
  expiresAt     DateTime            @db.Timestamptz(3)
  usedAt        DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt, usedAt])
}

model SpotifyCredential {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @unique @db.Uuid
  connectionId           String                @unique @db.Uuid
  provider               IntegrationProvider   @default(SPOTIFY)
  spotifyAccountId       String?               @unique @db.VarChar(255)
  spotifyProfileId       String?               @db.VarChar(255)
  accessTokenCiphertext  String                @db.Text
  accessTokenNonce       String                @db.VarChar(128)
  accessTokenTag         String                @db.VarChar(128)
  refreshTokenCiphertext String?               @db.Text
  refreshTokenNonce      String?               @db.VarChar(128)
  refreshTokenTag        String?               @db.VarChar(128)
  keyVersion             Int
  expiresAt              DateTime              @db.Timestamptz(3)
  authorizedAt           DateTime              @db.Timestamptz(3)
  market                 String?               @db.VarChar(2)
  preferredDeviceId      String?               @db.VarChar(255)
  scopes                 String[]
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection             IntegrationConnection @relation(fields: [connectionId, userId, provider], references: [id, userId, provider], onDelete: Cascade, map: "SpotifyCredential_connection_owner_provider_fkey")

  @@unique([connectionId, userId, provider])
}

model SpotifyAction {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @db.Uuid
  connectionId          String                @db.Uuid
  provider              IntegrationProvider   @default(SPOTIFY)
  action                String                @db.VarChar(64)
  payload               Json
  idempotencyKey        String                @db.VarChar(128)
  status                SpotifyActionStatus   @default(PENDING_CONFIRMATION)
  confirmationExpiresAt DateTime?             @db.Timestamptz(3)
  confirmedAt           DateTime?             @db.Timestamptz(3)
  resultCode            String?               @db.VarChar(64)
  resultMetadata        String?               @db.VarChar(2000)
  errorCode             String?               @db.VarChar(64)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection            IntegrationConnection @relation(fields: [connectionId, userId, provider], references: [id, userId, provider], onDelete: Cascade, map: "SpotifyAction_connection_owner_provider_fkey")

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
}

model WhatsAppConversation {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @db.Uuid
  connectionId       String                    @db.Uuid
  provider           IntegrationProvider       @default(WHATSAPP)
  opaqueChatRef      String                    @db.VarChar(255)
  displayName        String                    @db.VarChar(120)
  type               WhatsAppConversationType
  lastActivityAt     DateTime                  @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection         IntegrationConnection     @relation(fields: [connectionId, userId, provider], references: [id, userId, provider], onDelete: Cascade, map: "WhatsAppConversation_connection_owner_provider_fkey")
  deliveries         WhatsAppDelivery[]
  sendRequests       WhatsAppSendRequest[]
  aliases            WhatsAppConversationAlias[] @relation("WhatsAppConversationAliases")

  @@unique([id, userId, provider])
  @@unique([id, userId, connectionId, provider])
  @@unique([userId, connectionId, provider, opaqueChatRef])
  @@index([userId, lastActivityAt, id])
}

model WhatsAppConversationAlias {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  connectionId   String              @db.Uuid
  provider       IntegrationProvider @default(WHATSAPP)
  conversationId String              @db.Uuid
  providerRef    String              @db.VarChar(255)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection @relation(fields: [connectionId, userId, provider], references: [id, userId, provider], onDelete: Cascade, map: "WhatsAppConversationAlias_connection_owner_provider_fkey")
  conversation   WhatsAppConversation @relation("WhatsAppConversationAliases", fields: [conversationId, userId, connectionId, provider], references: [id, userId, connectionId, provider], onDelete: Cascade, map: "WhatsAppConversationAlias_conversation_owner_provider_fkey")

  @@unique([userId, connectionId, provider, providerRef])
  @@index([conversationId, userId, connectionId, provider])
}

model WhatsAppNotificationRule {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  connectionId    String                @db.Uuid
  provider        IntegrationProvider   @default(WHATSAPP)
  scope           WhatsAppRuleScope
  opaqueTargetRef String?               @db.VarChar(255)
  enabled         Boolean               @default(true)
  speakOnDevice   Boolean               @default(false)
  ruleMetadata    String?               @db.VarChar(2000)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      IntegrationConnection @relation(fields: [connectionId, userId, provider], references: [id, userId, provider], onDelete: Cascade, map: "WhatsAppNotificationRule_connection_owner_provider_fkey")

  // The SQL migration enforces target shape and separate global/targeted partial unique indexes.
  @@index([userId, enabled, updatedAt])
}

model WhatsAppSendRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @db.Uuid
  connectionId          String                @db.Uuid
  provider              IntegrationProvider   @default(WHATSAPP)
  conversationId        String?               @db.Uuid
  opaqueRecipientRef    String                @db.VarChar(255)
  preview               String                @db.VarChar(1000)
  idempotencyKey        String                @db.VarChar(128)
  status                WhatsAppSendStatus    @default(PENDING_CONFIRMATION)
  confirmationExpiresAt DateTime              @db.Timestamptz(3)
  confirmedAt           DateTime?             @db.Timestamptz(3)
  errorCode             String?               @db.VarChar(64)
  expiresAt             DateTime?             @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
