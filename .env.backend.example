# P7 backend deployment template. Replace placeholders out-of-band.
NODE_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
TRUST_PROXY_HOPS=1
PUBLIC_BASE_URL=https://api.personalbmo.web.id
# Pre-provision this protected path for runtime UID/GID 1000; Compose will not create it.
AVATAR_STORAGE_DIR=/opt/bmo/data/avatars
# Bound total time spent waiting for avatar admission and receiving multipart bytes.
AVATAR_UPLOAD_RECEIVE_TIMEOUT_MS=30000

DEVICE_ID=bmo-001
DEVICE_TOKEN=<placeholder>

HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=<placeholder>
HERMES_MODEL=hermes-agent
HERMES_CONVERSATION=bmo-001
HERMES_SOFT_TIMEOUT_MS=30000
HERMES_HARD_TIMEOUT_MS=180000
READINESS_PROBE_TIMEOUT_MS=2000

AUDIO_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_SERVICE_TOKEN=<placeholder>
AUDIO_SERVICE_STT_TIMEOUT_MS=90000
AUDIO_SERVICE_TTS_TIMEOUT_MS=180000

TEMP_AUDIO_DIR=/opt/bmo/temp/audio
TEMP_AUDIO_TTL_SECONDS=300
TEMP_AUDIO_CLEANUP_INTERVAL_SECONDS=30
REQUEST_TOMBSTONE_TTL_SECONDS=600
MAX_REQUEST_STORE_ENTRIES=1000
MAX_AUDIO_BYTES=3145728
MAX_AUDIO_DURATION_SECONDS=60
TOTAL_PIPELINE_TIMEOUT_MS=300000

HARDWARE_TEST_MODE=false
# Set only when HARDWARE_TEST_MODE=true:
# HARDWARE_TEST_MP3_PATH=/opt/bmo/app/backend/tests/fixtures/test-response.mp3

WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_INTERVAL_MS=60000
WS_MAX_MISSED_PONGS=2
WS_MAX_MESSAGE_BYTES=8192

# Application API foundation. Keep false until PostgreSQL and secrets are provisioned.
P9_ENABLED=false
# DATABASE_URL is assembled from a protected password file in the review/production operator path.
# P9_JWT_SECRET=<32-byte-or-longer-runtime-secret>
# P9_PAIRING_PEPPER=<32-byte-or-longer-runtime-secret>
# Candidate/production templates only; provision provider values out-of-band.
# P9_PROVIDER_ENCRYPTION_KEY_FILE=/opt/bmo/config/p9.1/provider-encryption-key
# SPOTIFY_CLIENT_ID_FILE=/opt/bmo/config/p9.1/spotify-client-id
# SPOTIFY_CLIENT_SECRET_FILE=/opt/bmo/config/p9.1/spotify-client-secret
# SPOTIFY_CALLBACK_URL=https://api.personalbmo.web.id/api/v1/integrations/spotify/callback
