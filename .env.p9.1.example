# Copy outside Git to the operator-controlled P9.1 config directory.
P9_ENABLED=true
BACKEND_ENV_FILE=/opt/bmo/config/backend.env
P9_POSTGRES_DB=bmo
P9_POSTGRES_USER=bmo
# The integrated candidate shares PostgreSQL's private Unix-socket volume.
P9_POSTGRES_SOCKET_DIR=/var/run/postgresql
# Hostname/port remain supported when a Unix socket is not mounted:
# P9_POSTGRES_HOST=postgres
# P9_POSTGRES_PORT=5432
P9_POSTGRES_PASSWORD_FILE=/opt/bmo/config/p9.1/postgres-password
P9_DATA_DIR=/opt/bmo/p9.1-data/postgres
P9_BACKUP_DIR=/opt/bmo/p9.1-backups
P9_BACKUP_PASSPHRASE_FILE=/opt/bmo/config/p9.1/backup-passphrase
P9_JWT_SECRET=<32-byte-or-longer-runtime-secret>
P9_PAIRING_PEPPER=<32-byte-or-longer-runtime-secret>
P9_WIFI_ENCRYPTION_KEY_FILE=/opt/bmo/config/p9.1/wifi-encryption-key
# Candidate-only provider secrets. Files must be owner-readable and never committed.
P9_PROVIDER_ENCRYPTION_KEY_FILE=/opt/bmo/config/p9.1/provider-encryption-key
SPOTIFY_CLIENT_ID_FILE=/opt/bmo/config/p9.1/spotify-client-id
SPOTIFY_CLIENT_SECRET_FILE=/opt/bmo/config/p9.1/spotify-client-secret
SPOTIFY_CALLBACK_URL=https://api.personalbmo.web.id/api/v1/integrations/spotify/callback
BUG_REPORT_STORAGE_DIR=/opt/bmo/data/bug-reports
AVATAR_UPLOAD_RECEIVE_TIMEOUT_MS=30000
