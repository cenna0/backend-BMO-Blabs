# Copy outside Git to the operator-controlled P9.1 config directory.
P9_ENABLED=true
P9_BIND_HOST=0.0.0.0
P9_BIND_PORT=3010
P9_POSTGRES_DB=bmo
P9_POSTGRES_USER=bmo
P9_POSTGRES_PASSWORD_FILE=/tmp/bmo-p9-1-validation-20260804/postgres-password
P9_DATA_DIR=/opt/bmo/p9.1-data/postgres
P9_BACKUP_DIR=/opt/bmo/p9.1-backups/daily
# Both *_FILE variables contain paths only, never secret values. The PostgreSQL
# password file is the approved isolated-candidate file and is owned by the
# runtime account with mode 0600. Backup fails closed before side effects when
# either file variable is missing or empty, unsafe, or unreadable.
# The encryption material is created manually outside the repository in
# protected secret storage; never put its value in this environment file.
P9_BACKUP_PASSPHRASE_FILE=/opt/bmo/secrets/p9.1/backup/backup-encryption-material-v1
# Restore is a future isolated rehearsal only. Supply a new explicitly named
# bmo_restore_<safe-id> target and the exact staged PC-copy directory as the
# p9:restore argument; never use the primary database name.
P9_RESTORE_DATABASE=bmo_restore_<safe-id>
P9_COMPOSE_PROJECT=bmo-p9-1
P9_COMPOSE_ENV_FILE=/tmp/bmo-p9-1-validation-20260804/compose.env
P9_JWT_SECRET=<32-byte-or-longer-runtime-secret>
P9_PAIRING_PEPPER=<32-byte-or-longer-runtime-secret>
# Isolated restored-target application acceptance is future operator action.
# These values are paths/identities only; do not provision the password file
# during repository verification or place any secret value in this file.
P9_ACCEPTANCE_DATABASE=bmo_restore_<safe-id>
P9_ACCEPTANCE_PORT=3025
P9_ACCEPTANCE_BIND_HOST=127.0.0.1
P9_ACCEPTANCE_NETWORK=bmo-p9-1_p9_private
P9_ACCEPTANCE_PROJECT=bmo-p9-1-restore-acceptance
P9_ACCEPTANCE_CONTAINER=bmo-p9-1-restore-acceptance-runtime
P9_ACCEPTANCE_POSTGRES_CONTAINER=bmo-p9-1-postgres-1
P9_ACCEPTANCE_IMAGE=bmo-p9.1-candidate:test
P9_ACCEPTANCE_CODE_DIR=/opt/bmo/app/backend/dist/src
P9_ACCEPTANCE_MIGRATIONS_DISABLED=true
P9_ACCEPTANCE_PASSWORD_FILE=/opt/bmo/secrets/p9.1/acceptance/login-password-v1
P9_ACCEPTANCE_RUNTIME_ENV_FILE=/tmp/bmo-p9-1-validation-20260804/compose.env
P9_ACCEPTANCE_STATE_FILE=/tmp/p9-acceptance/fixture-state.json
